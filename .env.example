# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application (injected automatically on AI Studio / Vercel).
APP_URL="MY_APP_URL"

# ADMIN_EMAIL & ADMIN_PASSWORD: Credentials for the /admin publishing portal.
# Change these in Vercel Environment Variables before going live.
ADMIN_EMAIL="admin@thietkeviet24h.vn"
ADMIN_PASSWORD="admin24h"

# MCP_API_KEY: Optional Bearer token to protect write tools in /api/mcp.
MCP_API_KEY=""
